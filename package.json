{
  "name": "kivi-semantic-memory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "setup": "npm run db:migrate && npm run ingest",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "reset": "tsx scripts/reset.ts",
    "ingest": "tsx scripts/ingest.ts --file corpus/corpus.jsonl --label corpus",
    "import:corpus": "tsx scripts/ingest.ts",
    "corpus:generate": "tsx scripts/generate-corpus.ts",
    "eval": "tsx scripts/eval.ts",
    "check:llm": "tsx scripts/check-llm.ts"
  },
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "dotenv": "^16.5.0",
    "drizzle-orm": "0.44.2",
    "next": "15.3.3",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.15.30",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "autoprefixer": "10.4.21",
    "drizzle-kit": "0.31.1",
    "postcss": "8.5.4",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
