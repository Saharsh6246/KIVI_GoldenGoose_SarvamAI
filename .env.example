# ---- Required ----
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# ---- Optional (defaults shown) ----
DATABASE_URL=./data/kivi.db
KIVI_MODEL_REASONING=gemini-3.5-flash-lite
# On a paid key, gemini-3.5-flash gives better tool use. Its FREE tier quota is far too
# small for the evaluation, so the default is flash-lite.
KIVI_MODEL_EXTRACTION=gemini-3.5-flash-lite
KIVI_MODEL_EMBEDDING=gemini-embedding-001
KIVI_EMBEDDING_DIM=768
# Retrieval score below which Hey Kivi refuses instead of answering
KIVI_REFUSAL_THRESHOLD=0.34
